{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/plan.schema.json",
  "title": "Plan",
  "description": "Canonical structured plan format for epic/story implementation plans and architecture breakdowns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "changedFiles"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "heroTitle": {
      "$ref": "#/$defs/heroTitle"
    },
    "firstStorySummary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "summary": {
      "$ref": "#/$defs/stringList"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/epic"
      }
    },
    "exitCriteria": {
      "$ref": "#/$defs/stringList"
    },
    "recommendedOrder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendedOrderItem"
      }
    },
    "changedFiles": {
      "type": "array",
      "description": "One or many filetrees describing the files changed once the plan is complete.",
      "items": {
        "$ref": "#/$defs/fileTree"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "heroTitle": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead"],
          "properties": {
            "lead": {
              "type": "string",
              "minLength": 1
            },
            "accent": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "ready",
        "in-progress",
        "blocked",
        "complete",
        "archived"
      ]
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "prose",
            "rules",
            "checklist",
            "ordered-steps",
            "architecture",
            "data-model",
            "requirements",
            "notes"
          ]
        },
        "summary": {
          "$ref": "#/$defs/stringList"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectionItem"
          }
        }
      }
    },
    "sectionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "stories"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortTitle": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Markdown narrative block rendered inside the epic's collapsible 'Design reference & examples' drawer."
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "dependencies": {
          "$ref": "#/$defs/refList"
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/story"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "dependencies": {
          "$ref": "#/$defs/refList"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Markdown narrative block rendered inside the story dialog's collapsible 'Design & source references' drawer."
        },
        "details": {
          "$ref": "#/$defs/stringList"
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/stringList"
        },
        "unitTests": {
          "$ref": "#/$defs/stringList"
        },
        "filesLikelyTouched": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "recommendedOrderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {
          "$ref": "#/$defs/slug"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Optional heading for a single tree (e.g. 'Source', 'Tests')."
        },
        "root": {
          "$ref": "#/$defs/fileTreeNode"
        }
      }
    },
    "fileTreeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["folder", "file"]
        },
        "status": {
          "type": "string",
          "enum": ["new", "modified"],
          "description": "Only valid on file nodes. Folders derive change state from their descendants."
        },
        "stories": {
          "$ref": "#/$defs/refList",
          "description": "Story IDs that touch this file. Only valid on file nodes."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileTreeNode"
          },
          "description": "Required for folder nodes. Absent for file nodes."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "folder" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["children"],
            "properties": {
              "status": { "type": "null", "description": "Folders must not carry a status." },
              "stories": { "type": "null", "description": "Folders must not carry stories." }
            }
          },
          "else": {
            "properties": {
              "children": { "type": "null", "description": "Files must not have children." }
            }
          }
        }
      ]
    }
  }
}
